    },
    "basicsSequence.skill.banishment.intro" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You will practice the two-finger Z scrub on dungeon foes—the same escape gesture that closes sheets and alerts when VoiceOver feels stuck. The full quest ends in Lights Off as proof you can apply it by ear."
          }
        }
      }
    },
    "basicsSequence.skill.banishment.title" : {
