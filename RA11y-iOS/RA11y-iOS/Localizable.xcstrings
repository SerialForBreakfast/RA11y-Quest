    "banishment.prologue.begin.a11yHint" : {
      "comment" : "VoiceOver hint for the prologue primary button.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starts practice, then the timed tower."
          }
        }
      }
    },
    "banishment.prologue.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Learn VoiceOver’s two-finger escape scrub. It dismisses blocking UI in apps and banishes traps in this quest. The run ends in Lights Off—proof you can do it without sighted cues."
          }
        }
      }
    },
    "banishment.prologue.instructions" : {
      "comment" : "Visible step list on the Banishment prologue; VoiceOver can swipe element by element.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Practice once, climb the timed tower, then finish in Lights Off—a single blacked-out threat to prove the scrub."
          }
        }
      }
    },
    "banishment.prologue.kicker" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escape gesture"
          }
        }
      }
    },
    "banishment.prologue.swipeExplainer" : {
      "comment" : "Visible copy on the Banishment prologue; pairs with the Z illustration.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draw a Z with two fingers to escape a trap."
          }
        }
      }
    },
    "banishment.prologue.swipeExplainer.a11y" : {
      "comment" : "VoiceOver label for banishment.prologue.swipeExplainer (can be fuller than on-screen text).",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe gesture lesson. With VoiceOver on, place two fingers on the screen and draw a Z: move to the top left, drag to the top right, diagonally to the lower left, then horizontally to the lower right. This is the escape scrub—it dismisses blocking UI and banishes creatures in this quest."
          }
        }
      }
    },
    "banishment.prologue.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Mark of Z"
          }
        }
      }
    },
