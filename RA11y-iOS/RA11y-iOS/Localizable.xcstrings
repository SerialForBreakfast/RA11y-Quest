    "basicsSequence.skill.arcanistsTower.intro" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You will practice the VoiceOver rotor so flicks jump chapter titles, whole storage niches, and margin links before you double-tap the clue target."
          }
        }
      }
    },
