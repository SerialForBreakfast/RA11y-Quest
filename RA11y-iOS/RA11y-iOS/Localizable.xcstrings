    "%@ %@ %@" : {
      "comment" : "A single string that succinctly describes the content of the view, suitable for VoiceOver. The first argument is the string “firstSpell.ready.body.line1”. The second argument is the string “firstSpell.ready.body.line2”. The third argument is the string “firstSpell.ready.body.line3”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@ %3$@"
          }
        }
      }
    },
    "%@. %@" : {
      "comment" : "An accessibility label that combines the main heading The first argument is the string “voiceOverRequired.siri.heading”. The second argument is the string “voiceOverRequired.siri.a11yLabel”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@. %2$@"
          }
        }
      }
    },
    "%@. %@ %@" : {
      "comment" : "A combined label for the skill transfer card, The first argument is the string “result.skillTransfer.heading”. The second argument is the string “result.skillTransfer.findAndFocus.body”, the string “result.skillTransfer.scrollHunt.body”, or the string “result.skillTransfer.banishment.body”. The third argument is the string “result.skillTransfer.findAndFocus.realWorld”, the string “result.skillTransfer.scrollHunt.realWorld”, or the string “result.skillTransfer.banishment.realWorld”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@. %2$@ %3$@"
          }
        }
      }
    },
