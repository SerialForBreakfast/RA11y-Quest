    "voiceOverHelp.header.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver is Apple's screen reader. It reads items on screen and changes how touch gestures work."
          }
        }
      }
    },
    "voiceOverHelp.header.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable VoiceOver"
          }
        }
      }
    },
    "voiceOverHelp.inApp.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This help sheet is a ScrollView. With VoiceOver on, use three-finger swipes to move through content. Tap Done to close."
          }
        }
      }
    },
    "voiceOverHelp.inApp.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In this app"
          }
        }
      }
    },
    "voiceOverHelp.navigationTitle" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver"
          }
        }
      }
    },
    "voiceOverHelp.quickToggle.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set up an Accessibility Shortcut in Settings → Accessibility → Accessibility Shortcut. Triple-click the Side button (most iPhones), Home button (older models), or Top button (many iPads) to toggle VoiceOver."
          }
        }
      }
    },
    "voiceOverHelp.quickToggle.tip" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tip: Adjust triple-click speed in Accessibility settings if the gesture feels too fast."
          }
        }
      }
    },
    "voiceOverHelp.quickToggle.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick toggle"
          }
        }
      }
    },
    "voiceOverHelp.scroll.swipeDown" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To scroll up a page: swipe down with three fingers."
          }
        }
      }
    },
    "voiceOverHelp.scroll.swipeUp" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To scroll down a page: swipe up with three fingers."
          }
        }
      }
    },
    "voiceOverHelp.scroll.tip" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If scrolling doesn't work, make sure your fingers are slightly apart and swipe with a quick motion."
          }
        }
      }
    },
    "voiceOverHelp.scroll.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
