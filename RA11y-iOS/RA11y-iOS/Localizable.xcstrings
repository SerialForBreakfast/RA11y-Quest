    "dungeon.a11y.l1.objective" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Objective: align the Moonstone with the center orb. Keep VoiceOver on the Moonstone alignment lane and three-finger scroll until the lock cue."
          }
        }
      }
    },
    "dungeon.a11y.l1.objective.format" : {
      "comment" : "VoiceOver objective for L1 resonance play; alignment metaphor only.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Objective: Align the Moonstone with the center orb. VoiceOver is on the Moonstone alignment lane. Three-finger scroll up or down until the lock cue."
          }
        }
      }
    },
    "dungeon.a11y.l1.objective.hint" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Three-finger swipes move the lane. If focus moves away, swipe back to Moonstone alignment lane, then try again."
          }
